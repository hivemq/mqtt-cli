{
    $schema: 'https://docs.renovatebot.com/renovate-schema.json',
    extends: [
        'local>hivemq/renovate-config:default.json5',
    ],
    baseBranchPatterns: [
        'master',
    ],
    useBaseBranchConfig: 'merge',
    branchPrefix: 'renovate/mqtt-cli/',
    addLabels: [
        'integrations-team-coordination',
    ],
    customManagers: [
        {
            customType: 'regex',
            datasourceTemplate: 'github-releases',
            depNameTemplate: 'graalvm/graalvm-ce-builds',
            description: 'GraalVM Community Edition used to build the native image',
            extractVersionTemplate: '^graal-(?<version>.+)$',
            managerFilePatterns: ['**/libs.versions.toml'],
            matchStrings: [
                'graalvm-community\\s*=\\s*"(?<currentValue>[^"]+)"',
            ],
            versioningTemplate: 'semver',
        },
    ],
}
